# Copy this file to backend/.env and fill it in. Never commit the real .env.

# Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model that reads the photo and writes the recipes.
GEMINI_MODEL=gemini-flash-lite-latest

# Optional shared secret. When set, the app must send the same value
# (EXPO_PUBLIC_RECIPAI_TOKEN in mobile/.env) or the server answers 401.
RECIPAI_APP_TOKEN=

# 1 = canned recipes instead of Gemini (try the app with no key and no cost).
RECIPAI_DEMO=0

# Browser origins allowed to call the API, comma separated. Only the web
# preview needs it (e.g. http://localhost:8081); the iPhone app does not.
RECIPAI_CORS_ORIGINS=

# Contact shown on /privacidad and /soporte (empty: only the GitHub issues link).
RECIPAI_CONTACT_EMAIL=

# Limits per client
RECIPAI_MAX_IMAGE_MB=6
RECIPAI_RATE_LIMIT_PER_HOUR=30
RECIPAI_GEMINI_TIMEOUT_SECONDS=90
