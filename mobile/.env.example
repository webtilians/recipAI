# Copy this file to mobile/.env. Expo bakes EXPO_PUBLIC_* values into the app
# when it bundles, so never put real secrets here.

# Backend address. While testing with Expo Go, use your PC's Wi-Fi IP
# (ipconfig → "Dirección IPv4"), e.g. http://192.168.1.50:8300
EXPO_PUBLIC_API_URL=

# Same value as RECIPAI_APP_TOKEN in backend/.env, if you set one.
EXPO_PUBLIC_RECIPAI_TOKEN=
